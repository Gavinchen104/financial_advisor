# Required
GEMINI_API_KEY=

# JWT signing key — any long random string. Change in prod.
SECRET_KEY=change-me-to-a-long-random-string

# Optional. Defaults to SQLite at ./data/app.db. For Postgres:
#   postgresql+psycopg://user:pass@host:5432/dbname
# (docker compose's app container ignores this and uses the internal `db` host;
#  override that with APP_DATABASE_URL.)
DATABASE_URL=

# "dev" (default) or "prod"
ENV=dev

# Public domain (prod only). For Oracle Cloud, setup.sh defaults this to
# a nip.io hostname based on your VM's public IP (e.g. 1-2-3-4.nip.io).
DOMAIN=

# ---------- RAG / Ask (docs/PROJECT2-PLAN.md) ----------
# Claude API key for /ask, relation extraction and evals. Locally use the
# stockify-eval workspace key; on Render use the stockify-prod key.
ANTHROPIC_API_KEY=

# SEC EDGAR's fair-access policy requires a descriptive User-Agent with contact info.
SEC_USER_AGENT="Your Name you@example.com"

# RAG tables need Postgres + pgvector >= 0.7 (docker compose provides it):
#   DATABASE_URL=postgresql+psycopg://stockify:stockify_dev@localhost:5432/stockify

# Models for POST /ask: anonymous callers get the default, signed-in users the authed model.
ASK_MODEL_DEFAULT=claude-haiku-5-5
ASK_MODEL_AUTHED=claude-sonnet-5-5

# Hard daily spend cap for /ask in USD. Requests beyond it get a 429.
ASK_DAILY_USD_CAP=1.00
