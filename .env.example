# Required
GEMINI_API_KEY=

# JWT signing key — any long random string. Change in prod.
SECRET_KEY=change-me-to-a-long-random-string

# Optional. Defaults to SQLite at ./data/app.db. For Postgres:
#   postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# "dev" (default) or "prod"
ENV=dev
